# ── 배포 설정 (이 파일을 config.env 로 복사한 뒤 값을 채우세요) ──
# config.env 는 비밀정보가 들어가므로 git 에 올리지 마세요(.gitignore 권장).

# SSH 접속 정보 (cafe24 VPS/클라우드)
SSH_USER="root"
SSH_HOST="jaguar.s4g.kr"        # 또는 서버 IP
SSH_PORT="22"

# (선택) SSH 키 경로. 비우면 비밀번호 입력 방식.
SSH_KEY=""                       # 예: ~/.ssh/id_rsa

# ── gallery-manager : Tomcat 에 war 배포 ──
TOMCAT_WEBAPPS="/usr/local/tomcat/webapps"   # 서버의 실제 Tomcat webapps 경로로 수정
# 현재 서버에 떠 있는 war 파일명과 반드시 동일하게! (ROOT.war 면 컨텍스트 '/', Manager.war 면 '/Manager')
MANAGER_WAR_NAME="ROOT.war"
# Tomcat 재시작 명령 (서버 환경에 맞게). systemd 면: "systemctl restart tomcat"
TOMCAT_RESTART_CMD="/usr/local/tomcat/bin/shutdown.sh; sleep 5; /usr/local/tomcat/bin/startup.sh"

# ── 실행형 jar 3종 (board / staff / talk) ──
# 서버에서 jar 들이 놓이는 디렉터리
REMOTE_APP_DIR="/home/gallery/apps"
# 각 모듈 실행 포트 (현재 운영값과 동일하게)
BOARD_PORT="8080"
STAFF_PORT="8081"
TALK_PORT="8082"
# jar 실행에 필요한 JDK (서버에 설치된 Java 11 경로). 비우면 PATH 의 java 사용.
REMOTE_JAVA=""                   # 예: /usr/lib/jvm/java-11/bin/java
